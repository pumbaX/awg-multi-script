#!/usr/bin/env bash
# awg-bot — управление Telegram-ботом awgToolza.
# Ставится в /usr/local/bin/awg-bot. Запуск: sudo awg-bot
set -euo pipefail

VERSION="2.1.4"

# ── откуда тянуть обновления (по аналогии с awg2 UPDATE_URL) ──
# Можно переопределить в /etc/awg-bot.conf строкой:  REPO_URL=https://github.com/USER/REPO
# Код бота лежит в подпапке awg_bot репозитория awg-multi-script
# (там же, где сам awg2.sh). Структура подпапки: awgbot/, run.py, requirements.txt, ...
DEFAULT_REPO_URL="https://github.com/pumbaX/awg-multi-script"
# Подпапка с кодом бота внутри репо (пусто = корень репо).
# Переопределяется строкой REPO_SUBDIR=... в /etc/awg-bot.conf
DEFAULT_REPO_SUBDIR="awg_bot"

DEST="/opt/awg-bot"
CONF="/etc/awg-bot.conf"
SERVICE="awg-bot.service"
SELF="/usr/local/bin/awg-bot"

R='\033[38;5;203m'; G='\033[0;32m'; Y='\033[0;33m'; C='\033[0;36m'
W='\033[1;37m'; D='\033[0;90m'; B='\033[1;94m'; N='\033[0m'
ok()   { echo -e "${G}  √ $*${N}"; }
err()  { echo -e "${R}  × $*${N}"; }
warn() { echo -e "${Y}  ▲ $*${N}"; }
info() { echo -e "${C}  → $*${N}"; }
hdr()  {
  echo -e "${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${N}"
  echo -e "  ${W}$*${N}"
  echo -e "${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${N}"
}

[[ $EUID -ne 0 ]] && { err "Запускай от root (sudo awg-bot)"; exit 1; }

# Читаем REPO_URL из конфига, если задан
get_repo_url() {
  local u=""
  [[ -f "$CONF" ]] && u=$(grep -m1 '^REPO_URL=' "$CONF" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' ' || true)
  echo "${u:-$DEFAULT_REPO_URL}"
}

get_repo_subdir() {
  local s=""
  [[ -f "$CONF" ]] && s=$(grep -m1 '^REPO_SUBDIR=' "$CONF" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' ' || true)
  echo "${s:-$DEFAULT_REPO_SUBDIR}"
}

# Проверяет, что в каталоге есть файлы бота. Возвращает 0/1.
validate_src() {
  local src="$1"
  [[ -d "$src/awgbot" && -f "$src/run.py" && -f "$src/requirements.txt" ]]
}

# ── Локальный источник кода ──
#
# Бот можно поставить из распакованного архива awg-toolza, минуя GitHub. Но
# обновление продолжало клонировать репозиторий — и накатывало поверх локальной
# сборки то, что лежит в репозитории, то есть откатывало непушенные правки.
# Поэтому путь запоминается в конфиге строкой LOCAL_SRC=… (пишет установщик или
# команда `awg-bot src <каталог>`), и update/reinstall берут код оттуда.

# Приводит путь к каталогу с awgbot/: принимает и корень пакета, и сам awg_bot/
normalize_src() {
  local d="${1%/}" sub
  [[ -z "$d" ]] && return 1
  sub=$(get_repo_subdir)
  if validate_src "$d"; then echo "$d"; return 0; fi
  if [[ -n "$sub" ]] && validate_src "$d/$sub"; then echo "$d/$sub"; return 0; fi
  return 1
}

get_local_src() {
  local s=""
  [[ -f "$CONF" ]] && s=$(grep -m1 '^LOCAL_SRC=' "$CONF" 2>/dev/null | cut -d= -f2- | tr -d '"'"'"' ' || true)
  echo "$s"
}

# $1 = каталог | "--github" (сбросить на клонирование)
set_local_src() {
  local val="$1" norm
  touch "$CONF" 2>/dev/null || true
  chmod 600 "$CONF" 2>/dev/null || true
  if [[ "$val" == "--github" || -z "$val" ]]; then
    sed -i '/^LOCAL_SRC=/d' "$CONF"
    ok "Источник кода: GitHub ($(get_repo_url))"
    return 0
  fi
  if ! norm=$(normalize_src "$val"); then
    err "В каталоге нет кода бота (awgbot/, run.py, requirements.txt): $val"
    return 1
  fi
  sed -i '/^LOCAL_SRC=/d' "$CONF"
  echo "LOCAL_SRC=${norm}" >> "$CONF"
  ok "Источник кода: локальный каталог ${norm}"
}

# Отдаёт каталог с кодом бота: локальный источник или свежий клон в $1.
# $2 (необязательно) — разовый путь, важнее записанного в конфиге.
resolve_src() {
  local tmp="$1" once="${2:-}" src=""

  if [[ -n "$once" ]]; then
    if src=$(normalize_src "$once"); then
      info "Код бота: ${src} (указан явно)" >&2
      echo "$src"; return 0
    fi
    err "В указанном каталоге нет кода бота: $once" >&2
    return 1
  fi

  local saved; saved=$(get_local_src)
  if [[ -n "$saved" ]]; then
    if src=$(normalize_src "$saved"); then
      info "Код бота: ${src} (локальный источник из ${CONF})" >&2
      echo "$src"; return 0
    fi
    warn "Локальный источник ${saved} пропал — беру код с GitHub" >&2
    warn "Задать заново: awg-bot src /путь/к/awg_bot" >&2
  fi

  clone_repo "$tmp"
}

# Клонирует репо в $1 (mktemp -d) и эхает путь к корню кода (с учётом REPO_SUBDIR).
# Возвращает 1 при ошибке клона или если структура не похожа на бота.
clone_repo() {
  local tmp="$1" url subdir src
  url=$(get_repo_url); subdir=$(get_repo_subdir)
  info "Клонирую ${url}…" >&2
  if ! git clone --depth 1 "$url" "$tmp/repo" >/dev/null 2>&1; then
    err "git clone не удался. Проверь REPO_URL в ${CONF} или доступ к сети." >&2
    return 1
  fi
  src="$tmp/repo"
  [[ -n "$subdir" ]] && src="$tmp/repo/$subdir"
  if ! validate_src "$src"; then
    err "В репозитории нет кода бота (awgbot/, run.py, requirements.txt)." >&2
    warn "Похоже, это не репозиторий бота. Если бот лежит в подпапке —" >&2
    warn "задай REPO_SUBDIR=имя_папки в ${CONF}." >&2
    return 1
  fi
  echo "$src"
}

# Копирует код из $1 в $DEST (без венв и конфига).
deploy_code() {
  local src="$1"
  rm -rf "$DEST/awgbot"
  cp -r "$src/awgbot" "$DEST/"
  cp "$src/run.py" "$src/requirements.txt" "$DEST/"
  # сам management-скрипт и юнит — если есть в репо
  [[ -f "$src/awg-bot" ]] && { cp "$src/awg-bot" "$SELF"; chmod +x "$SELF"; }
}

ensure_deps() {
  # git нужен только для клонирования: при локальном источнике не трогаем apt
  [[ -n "$(get_local_src)" ]] || command -v git >/dev/null 2>&1 || \
    { info "Ставлю git…"; apt-get install -y -qq git >/dev/null; }
  command -v python3 >/dev/null 2>&1 || { apt-get update -qq; apt-get install -y -qq python3 python3-venv; }
}

# ── 1) Переустановить (с нуля, спросит токен) ──
do_reinstall() {
  local once="${1:-}"
  hdr "Переустановка с нуля"
  warn "Будет перезаписан код в ${DEST} и переспрошены токен/ID."
  read -rp "$(echo -e "${C}  Продолжить? [y/N]: ${N}")" c; [[ "${c,,}" == y* ]] || { warn "Отмена"; return; }
  ensure_deps
  local tmp; tmp=$(mktemp -d)
  local src
  if ! src=$(resolve_src "$tmp" "$once"); then rm -rf "$tmp"; return 1; fi
  systemctl stop "$SERVICE" 2>/dev/null || true
  mkdir -p "$DEST"
  deploy_code "$src"
  rm -rf "$tmp"
  # venv
  [[ -d "$DEST/venv" ]] || python3 -m venv "$DEST/venv"
  "$DEST/venv/bin/pip" install -q --upgrade pip
  "$DEST/venv/bin/pip" install -q -r "$DEST/requirements.txt"
  # токен/ID
  read -rp "$(echo -e "${C}  Токен бота (@BotFather): ${N}")" BOT_TOKEN
  read -rp "$(echo -e "${C}  Твой Telegram ID (@userinfobot): ${N}")" ADMIN_ID
  touch "$CONF"; chmod 600 "$CONF"
  sed -i '/^BOT_TOKEN=/d;/^ADMIN_ID=/d' "$CONF"
  { echo "BOT_TOKEN=${BOT_TOKEN}"; echo "ADMIN_ID=${ADMIN_ID}"; } >> "$CONF"
  install_service
  systemctl restart "$SERVICE"
  sleep 2
  systemctl is-active --quiet "$SERVICE" && ok "Бот переустановлен и запущен" || err "Не стартует: journalctl -u awg-bot -n 30"
}

# ── 2) Обновить (сохраняя токен и chat_id) ──
do_update() {
  local once="${1:-}"
  hdr "Обновление (токен и ID сохраняются)"
  [[ -f "$CONF" ]] || { err "Нет ${CONF}. Сначала установи (п.1)."; return 1; }
  ensure_deps
  local tmp; tmp=$(mktemp -d)
  local src
  if ! src=$(resolve_src "$tmp" "$once"); then rm -rf "$tmp"; return 1; fi
  # бэкап текущего кода на случай отката
  local bak="${DEST}.bak.$(date +%s)"
  cp -r "$DEST" "$bak" 2>/dev/null && info "Бэкап старой версии: $bak"
  systemctl stop "$SERVICE" 2>/dev/null || true
  sleep 4   # даём Telegram отпустить getUpdates-сессию (иначе Conflict у нового процесса)
  deploy_code "$src"
  rm -rf "$tmp"
  # зависимости (вдруг добавились новые)
  "$DEST/venv/bin/pip" install -q --upgrade pip
  "$DEST/venv/bin/pip" install -q -r "$DEST/requirements.txt"
  systemctl restart "$SERVICE"
  # ждём старта до 15 секунд (несколько проверок)
  local up=0 i
  for i in 1 2 3 4 5 6 7; do
    sleep 2
    if systemctl is-active --quiet "$SERVICE"; then up=1; break; fi
  done
  if [[ "$up" == 1 ]]; then
    ok "Обновлено. Токен и ID сохранены (${CONF} не тронут)."
    # подчистим старые бэкапы, оставив 3 последних
    ls -dt "${DEST}".bak.* 2>/dev/null | tail -n +4 | xargs -r rm -rf
  else
    err "Новая версия не стартует — откатываю…"
    rm -rf "$DEST/awgbot"; cp -r "$bak/awgbot" "$DEST/" 2>/dev/null || true
    cp "$bak/run.py" "$bak/requirements.txt" "$DEST/" 2>/dev/null || true
    systemctl restart "$SERVICE" 2>/dev/null || true
    warn "Откат выполнен на предыдущую версию. Логи: journalctl -u awg-bot -n 30"
  fi
}

# ── 3) Перезапустить сервис ──
do_restart() {
  systemctl restart "$SERVICE" && ok "Сервис перезапущен" || err "Не удалось"
}

# ── 4) Статус ──
do_status() {
  hdr "Статус бота"
  systemctl is-active --quiet "$SERVICE" && echo -e "  Сервис: ${G}● активен${N}" || echo -e "  Сервис: ${R}○ остановлен${N}"
  systemctl is-enabled --quiet "$SERVICE" 2>/dev/null && echo -e "  Автозапуск: ${G}включён${N}" || echo -e "  Автозапуск: ${Y}выключен${N}"
  echo -e "  Версия awg-bot: ${W}${VERSION}${N}"
  echo -e "  Код: ${D}${DEST}${N}"
  local _ls; _ls=$(get_local_src)
  if [[ -n "$_ls" ]]; then
    if validate_src "$_ls"; then
      echo -e "  Источник: ${W}локальный${N} ${D}${_ls}${N}"
    else
      echo -e "  Источник: ${Y}локальный, но каталог пропал${N} ${D}${_ls}${N}"
    fi
  else
    echo -e "  Источник: ${D}GitHub $(get_repo_url)${N}"
  fi
  echo ""
  systemctl status "$SERVICE" --no-pager -n 5 2>/dev/null || true
}

# ── 5) Логи (последние 50 строк) ──
do_logs() {
  hdr "Логи (последние 50 строк)"
  journalctl -u "$SERVICE" --no-pager -n 50 2>/dev/null || warn "journalctl недоступен"
}

# ── 6) Удалить ──
#
# Два уровня:
#   remove — сервис, код в /opt, маркер для awg2. Конфиг с токеном остаётся,
#            чтобы переустановка не спрашивала его заново.
#   purge  — плюс состояние мониторинга, конфиг с токеном и сам этот скрипт.
#            Именно это имеется в виду под «удалить полностью»: после remove в
#            системе оставались команда awg-bot, /var/lib/awg-bot и токен.
# $1 = "purge" — полная очистка.
bot_remove_files() {
  local mode="${1:-remove}"
  systemctl stop "$SERVICE" 2>/dev/null || true
  systemctl disable "$SERVICE" 2>/dev/null || true
  rm -f "/etc/systemd/system/$SERVICE"
  systemctl daemon-reload 2>/dev/null || true
  systemctl reset-failed "$SERVICE" 2>/dev/null || true
  rm -rf "$DEST"
  rm -f /usr/local/bin/awg-bot.py   # маркер для awg2 (пункт 6)

  [[ "$mode" == "purge" ]] || return 0

  # Копию токена оставляем в папке бэкапов: «удалить полностью» не должно
  # означать «потерять токен» — иначе переустановка требует нового у BotFather.
  # То же делает awg2 в своём пункте удаления бота.
  if [[ -f "$CONF" ]]; then
    local bdir="${HOME:-/root}/awg_backup" saved
    mkdir -p "$bdir" 2>/dev/null || true
    saved="${bdir}/awg-bot.conf.$(date +%Y%m%d_%H%M%S)"
    if cp "$CONF" "$saved" 2>/dev/null; then
      chmod 600 "$saved" 2>/dev/null || true
      info "Токен сохранён: $saved"
    else
      warn "Не удалось сохранить копию токена — он будет потерян"
    fi
  fi

  rm -rf /var/lib/awg-bot
  rm -f "$CONF"
  # Себя удаляем последним и из отдельного процесса: bash дочитывает скрипт с
  # диска по ходу исполнения.
  ( sleep 1; rm -f "$SELF" ) >/dev/null 2>&1 &
  return 0
}

do_uninstall() {
  hdr "Удаление бота"
  warn "Будут удалены: сервис, код в ${DEST}, маркер для awg2."
  echo -e "  ${D}Конфиг VPN и клиенты не трогаются — только бот.${N}"
  read -rp "$(echo -e "${C}  Удалить всё под корень (токен ${CONF}, /var/lib/awg-bot, команду awg-bot)? [y/N]: ${N}")" purge
  read -rp "$(echo -e "${R}  Точно удалить бота? [y/N]: ${N}")" c
  [[ "${c,,}" == y* ]] || { warn "Отмена"; return; }

  if [[ "${purge,,}" == y* ]]; then
    bot_remove_files purge
    ok "Бот удалён полностью (вместе с токеном и командой awg-bot)"
  else
    bot_remove_files remove
    ok "Бот удалён (токен ${CONF} оставлен для переустановки)"
  fi
}

install_service() {
  cat > "/etc/systemd/system/$SERVICE" << EOF
[Unit]
Description=awgToolza Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=${DEST}
ExecStart=${DEST}/venv/bin/python ${DEST}/run.py
Restart=on-failure
RestartSec=5
Environment=AWG_BOT_CONF=${CONF}

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null 2>&1 || true
}

# ── 7) Источник кода ──
do_src_menu() {
  hdr "Источник кода бота"
  local cur; cur=$(get_local_src)
  if [[ -n "$cur" ]]; then
    echo -e "  Сейчас: ${W}локальный каталог${N} ${D}${cur}${N}"
    validate_src "$cur" || warn "Каталог не найден или в нём нет кода бота"
  else
    echo -e "  Сейчас: ${W}GitHub${N} ${D}$(get_repo_url)${N}"
  fi
  echo ""
  echo -e "  ${D}Локальный источник нужен, когда правки ещё не в репозитории:${N}"
  echo -e "  ${D}иначе «Обновить» накатит поверх них версию с GitHub.${N}"
  echo ""
  echo -e "  ${C}1)${N} Указать локальный каталог"
  echo -e "  ${C}2)${N} Вернуться на GitHub"
  echo -e "  ${C}0)${N} Отмена"
  echo ""
  local ch dir
  read -rp "$(echo -e "${C}  Выбор [0-2]: ${N}")" ch
  case "$ch" in
    1)
      read -rp "$(echo -e "${C}  Путь (например /opt/awg-toolza-v0.7.5): ${N}")" dir
      [[ -n "$dir" ]] && set_local_src "$dir" || warn "Пусто — отмена"
      ;;
    2) set_local_src --github ;;
    *) warn "Отмена" ;;
  esac
}

show_menu() {
  clear 2>/dev/null || true
  hdr "awgToolza Bot — управление  (v${VERSION})"
  echo ""
  echo -e "  ${C}1)${N} Переустановить (с нуля, спросит токен)"
  echo -e "  ${C}2)${N} Обновить (сохраняя токен и chat_id)"
  echo -e "  ${C}3)${N} Перезапустить сервис"
  echo -e "  ${C}4)${N} Статус"
  echo -e "  ${C}5)${N} Логи (последние 50 строк)"
  echo -e "  ${C}6)${N} Удалить"
  echo -e "  ${C}7)${N} Источник кода (локальный каталог / GitHub)"
  echo -e "  ${C}0)${N} Выход"
  echo ""
}

# Неинтерактивный режим: awg-bot update | restart | status | logs ...
# Разбор разового --src <каталог> для update/reinstall
_once_src=""
_args=("$@")
for _n in "${!_args[@]}"; do
  case "${_args[$_n]}" in
    --src)   _once_src="${_args[$((_n+1))]:-}" ;;
    --src=*) _once_src="${_args[$_n]#--src=}" ;;
  esac
done

case "${1:-}" in
  reinstall) do_reinstall "$_once_src"; exit 0 ;;
  update)    do_update "$_once_src";    exit 0 ;;
  src)
    # awg-bot src                → показать текущий источник
    # awg-bot src <каталог>      → запомнить локальный источник
    # awg-bot src --github       → вернуться на клонирование
    if [[ -z "${2:-}" ]]; then
      _ls=$(get_local_src)
      if [[ -n "$_ls" ]]; then echo "local $_ls"; else echo "github $(get_repo_url)"; fi
      exit 0
    fi
    set_local_src "$2"; exit $? ;;
  restart)   do_restart;   exit 0 ;;
  status)    do_status;    exit 0 ;;
  logs)      do_logs;      exit 0 ;;
  uninstall)
    # Неинтерактивные вызовы из бота:
    #   awg-bot uninstall --yes            — сервис и код, токен остаётся
    #   awg-bot uninstall --purge --yes    — всё, включая токен и сам awg-bot
    _purge=false; _yes=false
    for _a in "${@:2}"; do
      case "$_a" in
        --purge|--full) _purge=true ;;
        --yes|-y)       _yes=true ;;
      esac
    done
    if $_yes; then
      if $_purge; then bot_remove_files purge; else bot_remove_files remove; fi
      exit 0
    fi
    do_uninstall; exit 0 ;;
esac

while true; do
  show_menu
  read -rp "$(echo -e "${C}  Выбор [0-7]: ${N}")" CH
  case "$CH" in
    1) do_reinstall ;;
    2) do_update ;;
    3) do_restart ;;
    4) do_status ;;
    5) do_logs ;;
    6) do_uninstall; exit 0 ;;
    7) do_src_menu ;;
    0) exit 0 ;;
    *) warn "Неверный выбор" ;;
  esac
  echo ""
  read -rp "$(echo -e "${D}  Enter — вернуться в меню…${N}")" _
done
